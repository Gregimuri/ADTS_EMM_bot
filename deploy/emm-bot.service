[Unit]
Description=ADTS EMM Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/emm-bot
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/emm-bot/.venv/bin/python bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
